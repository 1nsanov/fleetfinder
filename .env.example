# Copy to .env and set your own values:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=FleetFinderDb

# MinIO (S3-compatible)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio_password
S3_BUCKET=fleetfinder
S3_SERVICE_URL=http://minio:9000
# Host-mapped MinIO port for browser image URLs
S3_PUBLIC_BASE_URL=http://localhost:9010
S3_REGION=us-east-1

# API — JWT (key should be >= 32 characters)
JWT_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ISSUER=FleetFinder.API
JWT_AUDIENCE=FleetFinder.Client

# Web UI
WEB_PORT=4200

# Demo seed (users + sample listings on first empty DB)
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo123!

# Optional: image registry prefix
# DOCKER_REGISTRY=
