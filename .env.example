# Copy to .env and set your own values:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=FleetFinderDb

# MinIO (S3-compatible)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio_password
S3_BUCKET=fleetfinder
S3_SERVICE_URL=http://fleetfinder.minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000

# API — password encryption (AES-256, Base64, exactly 32 bytes)
# Generate: openssl rand -base64 32
PASSWORD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# API — JWT (key should be >= 32 characters)
JWT_KEY=REPLACE_WITH_LONG_RANDOM_JWT_SECRET
JWT_ISSUER=FleetFinder.API
JWT_AUDIENCE=FleetFinder.Client

# Optional: image registry prefix
# DOCKER_REGISTRY=
